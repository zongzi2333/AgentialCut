        <mxCell id="note" value="Skill 数量不限、类型不限；按阶段装配，渐进加载，权限可控；不直接改项目。" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1000" height="24" as="geometry"/></mxCell>

