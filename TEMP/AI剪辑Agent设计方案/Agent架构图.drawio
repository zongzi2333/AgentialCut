  <diagram id="ai-editing-agent-architecture-v3" name="Agent 架构图">
    <mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <mxCell id="title" value="AI 剪辑 Agent 架构图" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1f1f1f;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="540" height="40" as="geometry"/></mxCell>
        <mxCell id="note" value="无制片人 Agent；流程控制器只执行状态机、两个审批门、版本和恢复。分镜 Agent 合并解析，并与素材检索 Agent 预检回改。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="540" height="44" as="geometry"/></mxCell>

        <mxCell id="user" value="用户" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#4a78c2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="40" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="controller" value="流程控制器（非 Agent）&lt;br&gt;阶段 / 审批门 / 版本 / 恢复" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#777;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="120" width="300" height="60" as="geometry"/></mxCell>

